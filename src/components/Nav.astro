<style>
  :root { --nav-h: 72px; }

  .site-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    height: var(--nav-h);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    background: rgba(7, 9, 15, 0.65);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    transition: background 0.3s, border-color 0.3s;
  }

  .nav-inner {
    height: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 64px);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(24px, 5vw, 64px);
  }

  /* ── Left ── */
  .nav-left { display: flex; align-items: center; gap: 16px; }

  .nav-logo {
    display: flex; align-items: center; gap: 12px;
    text-decoration: none;
  }
  .nav-avatar {
    width: 34px; height: 34px;
    border-radius: 50%; object-fit: cover; flex-shrink: 0;
    border: 1.5px solid rgba(255,255,255,0.15);
  }
  .nav-name {
    font-family: var(--font-mono); font-weight: 700; font-size: 13px;
    letter-spacing: 0.08em; color: #fff;
  }
  .nav-accent { color: var(--color-accent-light); }

  .universe-nav-btn {
    font-family: var(--font-mono); font-size: 11px;
    color: oklch(65% 0.22 260);
    border: 1px solid oklch(55% 0.22 260 / 0.4);
    padding: 6px 12px;
    border-radius: 6px;
    background: oklch(55% 0.22 260 / 0.08);
    text-decoration: none;
    opacity: 0; transform: scale(0.7); pointer-events: none;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .universe-nav-btn:hover {
    background: oklch(55% 0.22 260 / 0.18);
    border-color: oklch(65% 0.22 260 / 0.8);
    color: oklch(80% 0.22 260);
  }

  /* ── Center ── */
  .nav-links {
    display: flex; justify-content: center;
    gap: clamp(18px, 3vw, 40px);
    list-style: none; margin: 0; padding: 0;
  }
  .nav-link {
    font-size: 14px;
    color: rgba(255,255,255,0.65);
    text-decoration: none;
    transition: color 0.2s;
    position: relative; padding: 4px 0;
  }
  .nav-link:hover { color: #fff; }
  .nav-link::after {
    content: ''; position: absolute; bottom: -2px; left: 0;
    height: 1px; width: 0; background: var(--color-accent-light);
    transition: width 0.25s ease;
  }
  .nav-link:hover::after { width: 100%; }

  /* ── Right ── */
  .nav-right { display: flex; align-items: center; gap: 14px; }

  .nav-status {
    display: flex; align-items: center; gap: 7px;
    padding: 7px 14px; border-radius: 999px;
    background: rgba(74, 222, 128, 0.08);
    border: 1px solid rgba(74, 222, 128, 0.25);
    font-family: var(--font-mono); font-size: 11px; color: #4ade80;
    animation: glowPulse 2s ease-in-out infinite;
  }
  .nav-status-dot {
    width: 6px; height: 6px; border-radius: 50%; background: #4ade80; flex-shrink: 0;
  }

  .nav-lang {
    display: flex;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px; overflow: hidden;
  }
  .lang-btn {
    padding: 6px 10px;
    font-family: var(--font-mono); font-size: 11px;
    color: rgba(255,255,255,0.4); background: transparent;
    border: none; cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .lang-btn:not(:last-child) { border-right: 1px solid rgba(255,255,255,0.1); }
  .lang-btn.active { background: rgba(255,255,255,0.08); color: #fff; }
  .lang-btn:hover:not(.active) { color: rgba(255,255,255,0.7); }

  .nav-icon {
    width: 30px; height: 30px;
    display: flex; align-items: center; justify-content: center;
    color: rgba(255,255,255,0.45); text-decoration: none;
    transition: color 0.2s;
  }
  .nav-icon:hover { color: #fff; }

  /* ── Mobile ── */
  @media (max-width: 900px) {
    :root { --nav-h: 96px; }
    .nav-inner {
      grid-template-columns: auto 1fr;
      align-items: center;
      padding-top: 10px;
      padding-bottom: 10px;
    }
    .nav-left { flex-direction: column; align-items: flex-start; gap: 6px; }
    .nav-links, .nav-status { display: none; }
    .nav-right { justify-self: end; align-self: flex-start; padding-top: 4px; }
  }

  /* ── Universe pop-in ── */
  @keyframes universePopIn {
    0%   { opacity: 0; transform: scale(0.6); }
    60%  { opacity: 1; transform: scale(1.08); }
    100% { opacity: 1; transform: scale(1); }
  }
  .universe-nav-btn.universe-active {
    animation: universePopIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    pointer-events: auto;
  }

  /* ── Universe mode (light theme) ── */
  [data-universe="true"] .site-nav {
    background: rgba(255, 243, 224, 0.97);
    border-bottom-color: rgba(232, 91, 10, 0.12);
  }
  [data-universe="true"] .universe-nav-btn {
    color: #E85B0A;
    border-color: rgba(232, 91, 10, 0.45);
    background: rgba(232, 91, 10, 0.08);
  }
  [data-universe="true"] .nav-link { color: rgba(30,15,5,0.5); }
  [data-universe="true"] .nav-link:hover { color: #1A0D05; }
  [data-universe="true"] .nav-link::after { background: #E85B0A; }
  [data-universe="true"] .nav-name { color: #1A0D05; }
  [data-universe="true"] .nav-accent { color: #E85B0A; }
  [data-universe="true"] .nav-icon { color: rgba(30,15,5,0.4); }
  [data-universe="true"] .nav-icon:hover { color: #1A0D05; }
  [data-universe="true"] .lang-btn { color: rgba(30,15,5,0.35); }
  [data-universe="true"] .lang-btn.active { background: rgba(30,15,5,0.07); color: #1A0D05; }
  [data-universe="true"] .nav-lang { border-color: rgba(30,15,5,0.12); }
  [data-universe="true"] .lang-btn:not(:last-child) { border-right-color: rgba(30,15,5,0.1); }
  [data-universe="true"] .nav-status {
    background: rgba(232,91,10,0.06);
    border-color: rgba(232,91,10,0.22);
    color: #E85B0A; animation: none;
  }
  [data-universe="true"] .nav-status-dot { background: #E85B0A; }
</style>

