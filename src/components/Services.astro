---
import { SERVICES } from '../data/services';
---

<section id="services" class="services-section">
  <div class="services-container">

    <header class="services-bridge">
      <p class="bridge-pre">
        <span data-fr>Concrètement,</span>
        <span data-en>Concretely,</span>
      </p>
      <h2 class="bridge-title">
        <span data-fr>voici ce que je fais.</span>
        <span data-en>here's what I do.</span>
      </h2>
    </header>

    <div class="services-grid" id="services-cards">
      {SERVICES.map((service, i) => (
        <div class="service-card" role="article" style={`--i:${i}`}>
          <div class="icon-wrap">
            {service.icon}
          </div>
          <h3 class="svc-title">
            <span data-fr>{service.fr.title}</span><span data-en>{service.en.title}</span>
          </h3>
          <p class="svc-tagline">
            <span data-fr>{service.fr.tagline}</span>
            <span data-en>{service.en.tagline}</span>
          </p>
          <div class="svc-divider"></div>
          <p class="svc-desc">
            <span data-fr>{service.fr.desc}</span>
            <span data-en>{service.en.desc}</span>
          </p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .services-section {
    background: var(--color-bg);
    padding: clamp(40px, 6vw, 80px) 0 clamp(60px, 8vw, 100px);
  }

  .services-container {
    width: 100%;
    max-width: clamp(1100px, 88vw, 1500px);
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 64px);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 2vw, 32px);
  }
  @media (max-width: 900px) {
    .services-grid { grid-template-columns: 1fr; }
  }

  .service-card {
    background: var(--color-surface);
    border: 1px solid rgba(255,255,255,0.07);
    border-top: 2px solid var(--color-accent);
    border-radius: 14px;
    padding: clamp(24px, 2.5vw, 36px);
    cursor: default;
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.5s ease calc(var(--i) * 100ms),
      transform 0.5s ease calc(var(--i) * 100ms),
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }
  .service-card.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .service-card.visible:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    border-color: rgba(255,255,255,0.13);
  }

  .icon-wrap {
    width: 46px; height: 46px;
    border-radius: 10px;
    background: oklch(55% 0.22 260 / 0.1);
    border: 1px solid oklch(55% 0.22 260 / 0.2);
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
    flex-shrink: 0;
  }

  .svc-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(17px, 1.8vw, 26px);
    color: #fff;
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }

  .svc-tagline {
    font-family: var(--font-mono);
    font-size: clamp(11px, 0.85vw, 14px);
    line-height: 1.55;
    color: var(--color-accent-light);
    opacity: 0.65;
    margin-bottom: 1.25rem;
  }

  .svc-divider { height: 1px; background: rgba(255,255,255,0.07); }

  .svc-desc {
    font-size: clamp(13px, 1.2vw, 20px);
    line-height: 1.75;
    color: var(--color-muted);
    padding-top: 1.25rem;
  }
</style>

<script>
  const cards = document.querySelectorAll('#services-cards .service-card');
  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.15 });
  cards.forEach(c => observer.observe(c));
</script>
