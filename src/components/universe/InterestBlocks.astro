---
---

<section class="interests" data-animate-section>
  <div class="interests-inner">

    <!-- NBA -->
    <article class="card card-nba">
      <div class="nba-deco" aria-hidden="true">
        <span class="nba-num n23">23</span>
        <span class="nba-num n8">8</span>
        <span class="nba-num n3">3</span>
      </div>
      <div class="card-body">
        <span class="card-tag" style="color:#FDB927;border-color:rgba(253,185,39,0.25)">
          <span data-fr>Passion</span><span data-en>Passion</span>
        </span>
        <h3 class="card-title">Basketball &amp; NBA</h3>
        <p class="card-sub">
          <span data-fr>L'école de la performance</span>
          <span data-en>The school of performance</span>
        </p>
        <p class="card-desc">
          <span data-fr>Je fais partie de cette catégorie de personnes mettant un réveil à 3h du matin pour un match de saison régulière. L'art de vivre à l'heure américaine.</span>
          <span data-en>I'm the kind of person who sets a 3am alarm for a regular season game. The art of living on American time.</span>
        </p>
        <div class="nba-highlight">
          <span data-fr>Pèlerinage à Los Angeles — vivre l'intensité des Playoffs en direct. Case cochée.</span>
          <span data-en>Pilgrimage to Los Angeles — experiencing Playoffs intensity live. Box checked.</span>
        </div>
        <div class="pantheon">
          <p class="pantheon-label">
            <span data-fr>Mon Panthéon</span><span data-en>My Pantheon</span>
          </p>
          <div class="pantheon-row">
            <div class="pantheon-item">
              <span class="pantheon-name">MJ</span>
              <span class="pantheon-role">
                <span data-fr>Obsession chirurgicale</span>
                <span data-en>Surgical obsession</span>
              </span>
            </div>
            <div class="pantheon-divider" aria-hidden="true"></div>
            <div class="pantheon-item">
              <span class="pantheon-name">Kobe</span>
              <span class="pantheon-role">
                <span data-fr>Discipline brute</span>
                <span data-en>Raw discipline</span>
              </span>
            </div>
            <div class="pantheon-divider" aria-hidden="true"></div>
            <div class="pantheon-item">
              <span class="pantheon-name">Iverson</span>
              <span class="pantheon-role">
                <span data-fr>Chaos créatif</span>
                <span data-en>Creative chaos</span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </article>

    <!-- Homelab -->
    <article class="card card-homelab">
      <div class="card-body">
        <span class="card-tag card-tag--dark" style="color:#1d4ed8;border-color:rgba(29,78,216,0.25)">
          <span data-fr>Setup</span><span data-en>Setup</span>
        </span>
        <h3 class="card-title card-title--dark">Homelab</h3>
        <p class="card-desc card-desc--dark">
          <span data-fr>Là où mes idées quittent ma tête pour devenir des services tangibles. Bac à sable pour tester, casser et déployer à l'infini.</span>
          <span data-en>Where ideas leave my head and become tangible services. Sandbox for testing, breaking, and deploying indefinitely.</span>
        </p>
        <ul class="homelab-list">
          <li>
            <span class="hl-key">Infrastructure</span>
            <span class="hl-val">
              <span data-fr>Serveur maison, Docker &amp; Cloudflare Tunnels</span>
              <span data-en>Home server, Docker &amp; Cloudflare Tunnels</span>
            </span>
          </li>
          <li>
            <span class="hl-key">
              <span data-fr>IA &amp; Automatisation</span>
              <span data-en>AI &amp; Automation</span>
            </span>
            <span class="hl-val">
              <span data-fr>LLM locaux et workflows n8n</span>
              <span data-en>Local LLMs and n8n workflows</span>
            </span>
          </li>
          <li>
            <span class="hl-key">DevOps</span>
            <span class="hl-val">
              <span data-fr>Dashboards CI/CD qui tournent pendant que je dors</span>
              <span data-en>Dashboards, CI/CD running while I sleep</span>
            </span>
          </li>
        </ul>
      </div>
    </article>

    <!-- Gaming -->
    <article class="card card-gaming">
      <div class="card-body">
        <span class="card-tag" style="color:#a78bfa;border-color:rgba(167,139,250,0.25)">
          <span data-fr>Jeux Vidéo</span><span data-en>Gaming</span>
        </span>
        <h3 class="card-title">
          <span data-fr>Manette en main</span>
          <span data-en>Controller in hand</span>
        </h3>
        <p class="card-desc" style="color:rgba(255,255,255,0.4);max-width:400px">
          <span data-fr>Du pixel art 8-bit aux open-worlds cinématographiques — et des nuits entières à Azeroth parce que WoW Vanilla, ça ne se refuse pas.</span>
          <span data-en>From 8-bit pixel art to cinematic open worlds — and entire nights in Azeroth because WoW Vanilla just doesn't say no.</span>
        </p>
        <div class="game-grid">
          <div class="game-tile game-tile--wow">
            <div class="game-tile-bg" aria-hidden="true"></div>
            <div class="game-tile-content">
              <span class="game-icon">⚔️</span>
              <span class="game-name">WoW Vanilla</span>
              <span class="game-genre">MMORPG</span>
            </div>
          </div>
          <div class="game-tile game-tile--retro">
            <div class="game-tile-bg" aria-hidden="true"></div>
            <div class="game-tile-content">
              <span class="game-icon">🕹️</span>
              <span class="game-name">
                <span data-fr>Rétro</span><span data-en>Retro</span>
              </span>
              <span class="game-genre">8-bit · 16-bit</span>
            </div>
          </div>
          <div class="game-tile game-tile--aaa">
            <div class="game-tile-bg" aria-hidden="true"></div>
            <div class="game-tile-content">
              <span class="game-icon">🎮</span>
              <span class="game-name">Triple-A</span>
              <span class="game-genre">
                <span data-fr>Dernières sorties</span><span data-en>Latest releases</span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </article>

    <!-- Rythme & Code -->
    <article class="card card-music">
      <div class="music-inner">
        <div class="music-header">
          <span class="card-tag" style="color:rgba(255,255,255,0.35);border-color:rgba(255,255,255,0.12)">
            <span data-fr>Sounds</span><span data-en>Sounds</span>
          </span>
          <h3 class="card-title">
            <span data-fr>Rythme &amp; Code</span>
            <span data-en>Rhythm &amp; Code</span>
          </h3>
          <p class="card-desc" style="color:rgba(255,255,255,0.4)">
            <span data-fr>Chaque session a sa bande-son.</span>
            <span data-en>Every session has its soundtrack.</span>
          </p>
        </div>
        <div class="music-table-wrap">
          <table class="music-table">
            <thead>
              <tr>
                <th><span data-fr>Ambiance</span><span data-en>Mode</span></th>
                <th><span data-fr>Usage</span><span data-en>Use</span></th>
                <th><span data-fr>Genre</span><span data-en>Genre</span></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="mt-mode"><span data-fr>Focus</span><span data-en>Focus</span></td>
                <td><span data-fr>Debugging complexe</span><span data-en>Complex debugging</span></td>
                <td class="mt-genre">Lofi &amp; Synthwave</td>
              </tr>
              <tr>
                <td class="mt-mode"><span data-fr>Build Rapide</span><span data-en>Build Fast</span></td>
                <td><span data-fr>Sprint créatif</span><span data-en>Creative sprint</span></td>
                <td class="mt-genre">Metal — Gojira</td>
              </tr>
              <tr>
                <td class="mt-mode"><span data-fr>Deep Work</span><span data-en>Deep Work</span></td>
                <td><span data-fr>Session nocturne</span><span data-en>Late night session</span></td>
                <td class="mt-genre">Tyler the Creator</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </article>

  </div>
</section>

<style>
  .interests {
    padding: 2rem 2rem 0;
    background: var(--univ-bg, #FAF7F2);
  }

  .interests-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 5vw, 6rem);
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 1.25rem;
  }

  /* ── Cards base ── */
  .card {
    border-radius: 20px;
    overflow: hidden;
    position: relative;
  }

  .card-body {
    position: relative;
    z-index: 1;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .card-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 1px solid;
    padding: 2px 9px;
    border-radius: 3px;
    align-self: flex-start;
  }

  .card-tag--dark {
    color: rgba(26,13,5,0.45);
    border-color: rgba(26,13,5,0.12);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.15;
  }

  .card-title--dark { color: var(--univ-text, #1A0D05); }

  .card-sub {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: rgba(255,255,255,0.35);
    text-transform: uppercase;
    margin-top: -0.25rem;
  }

  .card-desc {
    font-size: 0.9rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.5);
  }

  .card-desc--dark { color: var(--univ-text-muted, rgba(30,15,5,0.5)); }

  /* ── NBA card ── */
  .card-nba {
    background: #1A0D03;
    border: 1px solid rgba(253,185,39,0.08);
    min-height: 520px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .nba-deco {
    position: absolute;
    inset: 0;
    pointer-events: none;
    user-select: none;
    overflow: hidden;
  }

  .nba-num {
    position: absolute;
    font-family: var(--font-display);
    font-weight: 900;
    line-height: 1;
    color: rgba(253,185,39,0.06);
  }

  .n23 { font-size: clamp(8rem, 22vw, 18rem); right: -1rem; top: -1rem; }
  .n8  { font-size: clamp(5rem, 14vw, 11rem); right: 6rem;  bottom: 8rem; color: rgba(201,8,42,0.06); }
  .n3  { font-size: clamp(3rem, 8vw,  6rem);  right: 2rem;  bottom: 3rem; color: rgba(232,91,10,0.05); }

  .nba-highlight {
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(253,185,39,0.8);
    background: rgba(253,185,39,0.06);
    border-left: 2px solid rgba(253,185,39,0.35);
    padding: 0.75rem 1rem;
    border-radius: 0 6px 6px 0;
  }

  .pantheon { margin-top: 0.5rem; }

  .pantheon-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.2);
    margin-bottom: 0.875rem;
  }

  .pantheon-row {
    display: flex;
    align-items: stretch;
  }

  .pantheon-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-right: 1.25rem;
  }

  .pantheon-divider {
    width: 1px;
    background: rgba(255,255,255,0.07);
    margin-right: 1.25rem;
    flex-shrink: 0;
  }

  .pantheon-name {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 800;
    color: #fff;
    line-height: 1;
  }

  .pantheon-role {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: rgba(255,255,255,0.3);
    line-height: 1.4;
  }

  /* ── Homelab card ── */
  .card-homelab {
    background: var(--univ-surface, #FFF0E0);
    border: 1px solid var(--univ-border, rgba(30,15,5,0.08));
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .homelab-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin-top: 0.25rem;
  }

  .homelab-list li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-left: 1rem;
    border-left: 2px solid rgba(29,78,216,0.2);
  }

  .hl-key {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1d4ed8;
  }

  .hl-val {
    font-size: 0.85rem;
    color: var(--univ-text-muted, rgba(30,15,5,0.5));
    line-height: 1.5;
  }

  /* ── Gaming card ── */
  .card-gaming {
    background: #0d0a1a;
    border: 1px solid rgba(167,139,250,0.1);
    min-height: 440px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .game-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .game-tile {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .game-tile-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .game-tile--wow .game-tile-bg {
    background: linear-gradient(160deg, #0f0c29 0%, #1a0533 40%, #3d1a6e 100%);
  }
  .game-tile--wow .game-tile-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 30%, rgba(212,175,55,0.18) 0%, transparent 70%);
  }

  .game-tile--retro .game-tile-bg {
    background: linear-gradient(160deg, #0a0010 0%, #2d0057 50%, #6b00a8 100%);
  }
  .game-tile--retro .game-tile-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(255,255,255,0.015) 2px,
      rgba(255,255,255,0.015) 4px
    );
  }

  .game-tile--aaa .game-tile-bg {
    background: linear-gradient(160deg, #050505 0%, #0d1117 40%, #1a1f2e 100%);
  }
  .game-tile--aaa .game-tile-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 80%, rgba(99,102,241,0.2) 0%, transparent 65%);
  }

  .game-tile-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.875rem;
    background: linear-gradient(0deg, rgba(0,0,0,0.75) 0%, transparent 100%);
  }

  .game-icon {
    font-size: 1.5rem;
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .game-name {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.2;
  }

  .game-genre {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
  }

  /* ── Music card ── */
  .card-music {
    background: #1A0D03;
    border: 1px solid rgba(255,255,255,0.04);
  }

  .music-inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    align-items: center;
    padding: 2.5rem clamp(1.5rem, 4vw, 3rem);
  }

  .music-header {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .music-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .music-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .music-table thead th {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.2);
    text-align: left;
    padding: 0 1.25rem 0.875rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .music-table tbody tr {
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }

  .music-table tbody tr:last-child { border-bottom: none; }

  .music-table tbody td {
    padding: 1rem 1.25rem 1rem 0;
    color: rgba(255,255,255,0.45);
    line-height: 1.4;
    vertical-align: middle;
  }

  .mt-mode {
    font-weight: 600;
    color: rgba(255,255,255,0.75) !important;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: 0.95rem !important;
  }

  .mt-genre {
    color: rgba(232,91,10,0.8) !important;
    font-family: var(--font-mono);
    font-size: 0.8rem !important;
    white-space: nowrap;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .interests-inner { grid-template-columns: 1fr; }
    .card-nba        { min-height: 440px; }
    .card-gaming     { min-height: auto; }
    .music-inner     { grid-template-columns: 1fr; gap: 1.5rem; }
  }

  @media (max-width: 500px) {
    .card-body       { padding: 1.75rem; }
    .pantheon-row    { flex-direction: column; gap: 1rem; }
    .pantheon-divider { display: none; }
    .game-grid       { gap: 0.5rem; }
  }
</style>
